{
  "chromium": "156.0.8078.4",
  "node": "v24.19.0",
  "ffmpeg": "ffmpeg version 7.1.5-0+deb13u1 Copyright (c) 2000-2026 the FFmpeg developers",
  "ffprobe": "ffprobe version 7.1.5-0+deb13u1 Copyright (c) 2007-2026 the FFmpeg developers",
  "encodeCommand": [
    "ffmpeg",
    "-y",
    "-framerate",
    "12",
    "-i",
    "/workspace/video-lab/.media-work/capture-%03d.png",
    "-f",
    "lavfi",
    "-i",
    "sine=frequency=440:sample_rate=48000:duration=10",
    "-map",
    "0:v:0",
    "-map",
    "1:a:0",
    "-c:v",
    "libx264",
    "-preset",
    "slow",
    "-crf",
    "23",
    "-pix_fmt",
    "yuv420p",
    "-c:a",
    "aac",
    "-b:a",
    "64k",
    "-af",
    "volume=0.08",
    "-t",
    "10",
    "-movflags",
    "+faststart",
    "public/media/build-queue.mp4"
  ],
  "probeCommand": [
    "ffprobe",
    "-v",
    "error",
    "-show_format",
    "-show_streams",
    "-show_frames",
    "-of",
    "json",
    "public/media/build-queue.mp4"
  ]
}
